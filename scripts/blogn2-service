#!/bin/bash
# BlogN2 FastAPI Service Script
# 使用方法: sudo ./blogn2-service {start|stop|restart|status}

# 服务配置
SERVICE_NAME="blogn2"
SERVICE_USER="wy"
SERVICE_HOME="$(dirname "$(dirname "$(readlink -f "$0")")")"
SERVICE_SCRIPT="run.py"
PID_FILE="/tmp/blogn2.pid"
LOG_FILE="/tmp/blogn2.log"

# 颜色定义
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# 检查进程是否运行
is_running() {
    if [ -f "$PID_FILE" ]; then
        local pid=$(cat "$PID_FILE")
        if ps -p "$pid" > /dev/null 2>&1; then
            return 0
        else
            rm -f "$PID_FILE"
        fi
    fi
    return 1
}

# 启动服务
start() {
    echo -e "${YELLOW}Starting $SERVICE_NAME...${NC}"
    
    if is_running; then
        echo -e "${YELLOW}$SERVICE_NAME is already running (PID: $(cat $PID_FILE))${NC}"
        return 0
    fi
    
    # 创建日志文件目录
    touch "$LOG_FILE"
    chown "$SERVICE_USER:$SERVICE_USER" "$LOG_FILE"
    
    # 切换到项目目录并启动应用
    cd "$SERVICE_HOME" || {
        echo -e "${RED}Error: Cannot change to directory $SERVICE_HOME${NC}"
        return 1
    }
    
    # 使用nohup启动应用
    nohup bash -c "cd $SERVICE_HOME && source /home/`whoami`/blogn2-env/bin/activate && python $SERVICE_SCRIPT" > "$LOG_FILE" 2>&1 &
    local bash_pid=$!
    
    # 等待一下让进程启动，然后找到Python进程的PID
    sleep 3
    local python_pid=$(ps aux | grep "python $SERVICE_SCRIPT" | grep -v grep | awk '{print $2}' | head -1)
    
    if [ -n "$python_pid" ]; then
        echo $python_pid > "$PID_FILE"
        echo -e "${GREEN}$SERVICE_NAME started successfully (PID: $python_pid)${NC}"
        echo -e "${GREEN}Log file: $LOG_FILE${NC}"
        return 0
    else
        echo -e "${RED}Failed to start $SERVICE_NAME - Python process not found${NC}"
        echo -e "${YELLOW}Check log file: $LOG_FILE${NC}"
        return 1
    fi
}

# 停止服务
stop() {
    echo -e "${YELLOW}Stopping $SERVICE_NAME...${NC}"
    
    if [ -f "$PID_FILE" ]; then
        local pid=$(cat "$PID_FILE")
        if ps -p "$pid" > /dev/null 2>&1; then
            kill "$pid"
            sleep 2
            
            # 如果进程还在运行，强制杀死
            if ps -p "$pid" > /dev/null 2>&1; then
                echo -e "${YELLOW}Force killing process $pid...${NC}"
                kill -9 "$pid"
            fi
            
            rm -f "$PID_FILE"
            echo -e "${GREEN}$SERVICE_NAME stopped${NC}"
        else
            echo -e "${YELLOW}$SERVICE_NAME is not running${NC}"
            rm -f "$PID_FILE"
        fi
    else
        echo -e "${YELLOW}$SERVICE_NAME is not running${NC}"
    fi
}

# 重启服务
restart() {
    echo -e "${YELLOW}Restarting $SERVICE_NAME...${NC}"
    stop
    sleep 1
    start
}

# 查看状态
status() {
    if is_running; then
        local pid=$(cat "$PID_FILE")
        echo -e "${GREEN}$SERVICE_NAME is running (PID: $pid)${NC}"
        echo -e "${GREEN}Log file: $LOG_FILE${NC}"
        
        # 检查端口是否在监听
        if netstat -tlnp 2>/dev/null | grep -q ":8000.*LISTEN"; then
            echo -e "${GREEN}Port 8000 is listening${NC}"
        else
            echo -e "${RED}Port 8000 is not listening${NC}"
        fi
        
        # 显示最近的日志
        if [ -f "$LOG_FILE" ]; then
            echo -e "${YELLOW}Recent log entries:${NC}"
            tail -n 5 "$LOG_FILE" 2>/dev/null || echo "No log entries found"
        fi
    else
        echo -e "${RED}$SERVICE_NAME is not running${NC}"
    fi
}

# 查看日志
logs() {
    if [ -f "$LOG_FILE" ]; then
        tail -f "$LOG_FILE"
    else
        echo -e "${RED}Log file not found: $LOG_FILE${NC}"
    fi
}

# 主函数
case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        restart
        ;;
    status)
        status
        ;;
    logs)
        logs
        ;;
    *)
        echo "Usage: $0 {start|stop|restart|status|logs}"
        echo ""
        echo "Commands:"
        echo "  start   - Start the BlogN2 FastAPI service"
        echo "  stop    - Stop the BlogN2 FastAPI service"
        echo "  restart - Restart the BlogN2 FastAPI service"
        echo "  status  - Show service status"
        echo "  logs    - Show and follow log file"
        exit 1
        ;;
esac

exit 0 
