# BlogN2 Docker 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改配置

# ==================== 数据库配置 ====================
# PostgreSQL 数据库连接URL（从外部PostgreSQL服务连接）
# 格式: postgresql+asyncpg://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql+asyncpg://blogn_user:blogn_password@postgres-host:5432/blogn_example

# ==================== Redis 配置 ====================
# Redis 服务器地址（从外部Redis服务连接）
CACHE_REDIS_HOST=redis-host
CACHE_REDIS_PORT=6379
CACHE_REDIS_PASSWORD=
CACHE_REDIS_DB=0
CACHE_REDIS_SSL=false

# 缓存策略配置
CACHE_ENABLE_CACHE=true
CACHE_DEFAULT_TTL=600
CACHE_MAX_TTL=86400
CACHE_CACHE_PREFIX=blogn2
CACHE_CACHE_DEBUG=false

# ==================== Docker 卷挂载路径（宿主机）====================
# 以下为 docker-compose 中 volume 的宿主机路径，若 BERT/缓存 不在默认目录，在此覆盖
# HF 缓存根目录（容器内挂载到 /app/.cache/huggingface）
# HF_CACHE_HOST_PATH=/home/wy/.cache/huggingface
# BERT 模型 hub 目录：宿主机上含 snapshots/ 的目录（容器内挂载到 /app/.cache/models/bert-model-hub）
# 与 HF_CACHE_HOST_PATH 二选一即可；若 BERT 在其它盘或目录，例如：
# BERT_MODEL_HUB_HOST_PATH=/data/models/paraphrase-multilingual-MiniLM-L12-v2
# MODELSCOPE_CACHE_HOST_PATH=/home/wy/.cache/modelscope

# ==================== BERT 模型配置 ====================
# 模型名称（从 Hugging Face 下载）
MODEL_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# 本地模型路径（容器内由 entrypoint 解析，一般无需在 .env 中设置）
MODEL_MODEL_PATH=

# 模型运行设备（cpu/cuda/cuda:0/auto）
MODEL_DEVICE=cpu

# 模型参数
MODEL_MAX_LENGTH=512
MODEL_VECTOR_DIMENSION=384

# 模型加载策略
MODEL_PREFER_LOCAL=false
MODEL_FALLBACK_TO_HUGGINGFACE=true

# 模型缓存目录（容器内路径，可通过volume挂载外部目录）
MODEL_CACHE_DIR=/app/.cache/models

# ==================== 应用配置 ====================
# 调试模式
DEBUG=false

# 应用基础URL（用于生成链接，应设置为实际的HTTPS域名）
BASE_URL=https://yourdomain.com

# JWT密钥（生产环境必须修改为强随机字符串）
SECRET_KEY=your-super-secret-jwt-key-change-in-production

# 日志级别（debug/info/warning/error，默认：warning）
# warning: 只显示警告和错误（推荐生产环境）
# error: 只显示错误
# info: 显示信息、警告和错误
# debug: 显示所有日志（包括调试信息）
LOG_LEVEL=warning

# ==================== 文件上传配置 ====================
# 文件上传目录（容器内路径，通过volume挂载）
UPLOAD_DIR=/app/uploads

# 用户头像目录（容器内路径，通过volume挂载）
AVATAR_DIR=/app/avatars

# 文件大小限制（字节，默认10MB）
MAX_FILE_SIZE=10485760

# 允许的文件类型
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif

# ==================== 业务配置 ====================
# 博客文章每页显示数量
BLOG_POSTS_PAGE_SIZE=10

# 每篇文章最大附件数量
MAX_ATTACHMENTS_PER_ARTICLE=10

# ==================== 邮件重置密码（宿主机 sendmail）====================
# 发件人地址
MAIL_FROM=noreply@yourdomain.com
# 重置链接有效期（分钟）
RESET_LINK_EXPIRE_MINUTES=60
# 使用宿主机 sendmail：host 网络下填 localhost，否则填宿主机 IP 或 host.docker.internal
SMTP_HOST=localhost
SMTP_PORT=25

# ==================== 注意事项 ====================
# 1. DATABASE_URL 必须指向可访问的PostgreSQL服务器
# 2. CACHE_REDIS_HOST 必须指向可访问的Redis服务器
# 3. MODEL_CACHE_DIR 建议通过volume挂载，避免容器重启后重新下载模型
# 4. UPLOAD_DIR 和 AVATAR_DIR 必须通过volume挂载，确保数据持久化
# 5. SECRET_KEY 生产环境必须使用强随机字符串
# 6. BASE_URL 应设置为实际的HTTPS域名，用于生成正确的链接

