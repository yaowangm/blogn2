# 数据库配置
# 请复制此文件为 .env 并填入实际的数据库连接信息
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/database_name

# 应用配置
APP_NAME=BlogN2
APP_VERSION=1.0.0
DEBUG=true

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 安全配置
SECRET_KEY=your-secret-key-here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
