# BlogN2 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# ==================== 数据库配置 ====================
# PostgreSQL数据库连接URL
# 密码若含 @ # : / % 等特殊字符，需做 URL 编码（如 @ → %40，# → %23）
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/blogn_example
# 运行 pytest 时请使用独立测试库或副本；勿对生产库跑集成测试。
# 集成测试若 commit 写库，须在 test_data_tracker（或 get_test_data_tracker()）上 add_* 登记 ID；
# 用例结束会仅按登记的 ID 删除，未登记则不会删库。
# 仅在明确需要「旧版按关键字 DELETE」且确认数据库可丢弃时使用（勿对生产库）：
# BLOGN_ALLOW_DANGEROUS_TEST_SQL_CLEANUP=

# ==================== Redis缓存配置 ====================
# Redis服务器地址
CACHE_REDIS_HOST=localhost

# Redis服务器端口
CACHE_REDIS_PORT=6379

# Redis数据库编号
CACHE_REDIS_DB=0

# Redis密码（可选，留空表示无密码）
CACHE_REDIS_PASSWORD=

# 是否使用SSL连接Redis
CACHE_REDIS_SSL=false

# ==================== 缓存策略配置 ====================
# 是否启用缓存功能
CACHE_ENABLE_CACHE=false

# 是否启用缓存调试模式
CACHE_CACHE_DEBUG=false

# 默认缓存时间（秒，10分钟）
CACHE_DEFAULT_TTL=600

# 最大缓存时间（秒，24小时）
CACHE_MAX_TTL=86400

# 缓存键前缀
CACHE_CACHE_PREFIX=blogn2

# ==================== 应用配置 ====================
# 调试模式
DEBUG=true

# 日志级别：传给 Uvicorn（与 ``uvicorn --log-level`` 一致）
# 可选：critical、error、warning、info、debug、trace（大小写不敏感）
# 未设置或拼写不在上述范围时，本地 run.py / python -m 启动默认按 info
# Docker：见 docker/docker-entrypoint.sh，未设置 LOG_LEVEL 时默认 warning
LOG_LEVEL=INFO

# 博客文章列表每页显示数量
BLOG_POSTS_PAGE_SIZE=10

# ==================== 安全配置 ====================
# 密钥（用于JWT等加密）
SECRET_KEY=your-secret-key-here
# 文章详情访问量去重 Cookie 的 Max-Age（秒），默认 3600，范围 60–86400
# ARTICLE_HIT_COOKIE_MAX_AGE=3600
# 生产环境全站 HTTPS 时可设为 true，为 Cookie 加上 Secure
# ARTICLE_HIT_COOKIE_SECURE=false

# 访问令牌过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=30
# 刷新令牌过期时间（天）
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==================== 文件上传配置 ====================
# 最大文件大小（字节）
MAX_FILE_SIZE=10485760

# 允许的文件类型
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif

# 上传目录（本地与 Docker 共用：本地填宿主机路径，Docker 由 compose 覆盖为 /app/uploads 并挂载此处路径）
# 示例：相对路径 ../pic/blogn_img/upload 或绝对路径 /home/you/pic/blogn_img/upload
UPLOAD_DIR=../pic/blogn_img/upload

# 头像目录（本地与 Docker 共用：本地填宿主机路径，Docker 由 compose 覆盖为 /app/avatars 并挂载此处路径）
# 示例：相对路径 ../pic/blogn_img/userlogo 或绝对路径 /home/you/pic/blogn_img/userlogo
AVATAR_DIR=../pic/blogn_img/userlogo

# 应用基础URL（用于RSS、邮件等链接生成）
BASE_URL=http://localhost:8000

# ==================== 邮件重置密码 ====================
# 发件人地址（密码重置邮件）
MAIL_FROM=noreply@bloggern.com
# 重置链接有效期（分钟）
RESET_LINK_EXPIRE_MINUTES=60
# SMTP 主机：留空则使用本机 sendmail 命令；Docker 内留空时会自动使用 localhost（需 host 网络）。也可填 host.docker.internal 等
SMTP_HOST=
# SMTP 端口（默认 25）
SMTP_PORT=25

# 每篇文章最大附件数量
MAX_ATTACHMENTS_PER_ARTICLE=10

# ==================== 模型配置 ====================
# BERT 模型宿主机路径（Docker 卷挂载用，compose 会挂载到容器内 bert-model-hub）
# BERT_MODEL_HUB_HOST_PATH=/path/to/huggingface/hub/models--sentence-transformers--paraphrase-multilingual-MiniLM-L12-v2

# BERT模型名称（用于文本向量化）
MODEL_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Docker 内使用挂载的模型目录（由 entrypoint 解析到 snapshot，一般无需改；仅 Docker 时由 compose 覆盖）
# MODEL_MODEL_PATH=/app/.cache/models/bert-model

# 是否优先使用本地模型
MODEL_PREFER_LOCAL=true

# 本地模型失败时是否回退到Hugging Face
MODEL_FALLBACK_TO_HUGGINGFACE=true

# 模型缓存目录（下载/加载均使用此目录，离线可先下载后拷贝该目录）
# MODEL_CACHE_DIR=/path/to/cache

# 模型运行设备（auto, cpu, cuda, cuda:0等）
MODEL_DEVICE=auto

# 模型最大输入长度
MODEL_MAX_LENGTH=512

# 向量维度
MODEL_VECTOR_DIMENSION=384
