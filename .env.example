# BlogN2 环境变量配置模板
# 复制此文件为 .env 并填入实际值（.env 不纳入版本库）
# 活动配置项须与 .env 键名完全一致；可选/测试专用项仅以注释形式出现在本文件

# ==================== 数据库配置 ====================
# PostgreSQL 连接 URL；密码含 @ # : / % 等须 URL 编码（@ → %40，# → %23）
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/blogn_example
# pytest：使用独立测试库；集成测试写库须在 test_data_tracker 登记 ID，结束按 ID 删除
# 仅测试专用（勿写入 .env 活动项；勿对生产库）：BLOGN_ALLOW_DANGEROUS_TEST_SQL_CLEANUP=1

# ==================== Redis 缓存配置 ====================
CACHE_REDIS_HOST=localhost
CACHE_REDIS_PORT=6379
CACHE_REDIS_DB=0
CACHE_REDIS_PASSWORD=
CACHE_REDIS_SSL=false

# ==================== 缓存策略配置 ====================
# 可选性能加速器：false 时与无 Redis 行为一致（直连 DB/API）；true 且 Redis 可用时缓存热路径
CACHE_ENABLE_CACHE=false
CACHE_CACHE_DEBUG=false
CACHE_DEFAULT_TTL=600
CACHE_MAX_TTL=86400
CACHE_CACHE_PREFIX=blogn2

# ==================== 应用配置 ====================
DEBUG=true
# Uvicorn 日志级别：critical/error/warning/info/debug/trace；Docker 未设时 entrypoint 默认 warning
LOG_LEVEL=INFO
BLOG_POSTS_PAGE_SIZE=10
# 静态资源版本号（?v=）；日常发版由 ./docker/build-app.sh 自动生成 UTC 时间戳并写入 .static_version
# 仅在手动覆盖时取消注释：
# STATIC_VERSION=20250609120000

# ==================== 安全配置（JWT 等） ====================
SECRET_KEY=your-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# 可选（有代码默认值，勿作为 .env 活动项除非需要覆盖）：
# ARTICLE_HIT_COOKIE_MAX_AGE=3600
# ARTICLE_HIT_COOKIE_SECURE=false

# ==================== 认证安全（PostgreSQL user_auth_security_state） ====================
# 写库失败时是否拒绝认证请求（true=更安全）；迁移期可读已废弃 AUTH_FAIL_CLOSED_WHEN_REDIS_DOWN
AUTH_FAIL_CLOSED_WHEN_DB_ERROR=true
AUTH_LOGIN_MAX_FAIL_PER_ACCOUNT=5
AUTH_LOGIN_LOCK_SECONDS=86400
AUTH_LOGIN_MIN_INTERVAL_SECONDS=5
AUTH_PWDRESET_REQ_MAX_PER_EMAIL=3
AUTH_PWDRESET_REQ_WINDOW_SECONDS=3600
AUTH_PWDRESET_VALIDATE_MAX_PER_USER=30
AUTH_PWDRESET_VALIDATE_WINDOW_SECONDS=3600
AUTH_REGISTER_MAX_PER_USER=10
AUTH_REGISTER_WINDOW_SECONDS=3600

# ==================== CORS（生产建议收敛为明确域名） ====================
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=false

# ==================== 文件上传 ====================
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif
# 本地用相对/绝对宿主机路径；Docker compose 可覆盖为容器路径并挂载
UPLOAD_DIR=../pic/blogn_img/upload
AVATAR_DIR=../pic/blogn_img/userlogo
MAX_ATTACHMENTS_PER_ARTICLE=10

# ==================== 站点 URL ====================
# RSS、密码重置邮件、分享预览 og:url/og:image 等绝对链接
BASE_URL=http://localhost:8000
# 可选：分享合并公网 base 时允许 http（默认同主机名时抬升为 https）
# OG_ALLOW_HTTP_PUBLIC_BASE=0

# ==================== 邮件（密码重置） ====================
MAIL_FROM=noreply@example.com
RESET_LINK_EXPIRE_MINUTES=60
# 留空则用本机 sendmail；Docker host 网络下可填 localhost
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=

# ==================== BERT / 向量化模型 ====================
# 宿主机模型目录（含 snapshots 的 hub 路径）；Docker 卷挂载时常用
BERT_MODEL_HUB_HOST_PATH=/path/to/huggingface/hub/models--sentence-transformers--paraphrase-multilingual-MiniLM-L12-v2
MODEL_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# 容器内解析后的模型路径；本地开发可指向本机 snapshot 或留容器路径由代码回退到 HUB 路径
MODEL_MODEL_PATH=/app/.cache/models/bert-model
MODEL_PREFER_LOCAL=true
MODEL_FALLBACK_TO_HUGGINGFACE=true
# MODEL_CACHE_DIR=/path/to/cache
MODEL_DEVICE=auto
MODEL_MAX_LENGTH=512
MODEL_VECTOR_DIMENSION=384
