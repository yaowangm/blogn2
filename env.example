# BlogN2 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# ==================== 数据库配置 ====================
# PostgreSQL数据库连接URL
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/database_name

# ==================== Redis缓存配置 ====================
# Redis服务器地址
CACHE_REDIS_HOST=localhost

# Redis服务器端口
CACHE_REDIS_PORT=6379

# Redis数据库编号
CACHE_REDIS_DB=0

# Redis密码（可选，留空表示无密码）
CACHE_REDIS_PASSWORD=

# 是否使用SSL连接Redis
CACHE_REDIS_SSL=false

# ==================== 缓存策略配置 ====================
# 是否启用缓存功能
CACHE_ENABLE_CACHE=true

# 是否启用缓存调试模式
CACHE_CACHE_DEBUG=false

# 默认缓存时间（秒，10分钟）
CACHE_DEFAULT_TTL=600

# 最大缓存时间（秒，24小时）
CACHE_MAX_TTL=86400

# 缓存键前缀
CACHE_CACHE_PREFIX=blogn2

# ==================== 应用配置 ====================
# 应用环境（development, production, testing）
APP_ENV=development

# 调试模式
DEBUG=true

# 日志级别
LOG_LEVEL=INFO

# ==================== 安全配置 ====================
# 密钥（用于JWT等加密）
SECRET_KEY=your-secret-key-here

# 访问令牌过期时间（秒）
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==================== 文件上传配置 ====================
# 最大文件大小（字节）
MAX_FILE_SIZE=10485760

# 允许的文件类型
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif

# 上传目录
UPLOAD_DIR=../pic/blogn_img/upload

# 头像目录
AVATAR_DIR=../pic/blogn_img/userlogo
