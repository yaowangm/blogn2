# 数据库配置
# 请复制此文件为 .env 并填入实际的数据库连接信息
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/blogn2

# Redis缓存配置
# Redis服务器地址
CACHE_REDIS_HOST=localhost
# Redis服务器端口
CACHE_REDIS_PORT=6379
# Redis数据库编号
CACHE_REDIS_DB=0
# Redis密码（可选，留空表示无密码）
CACHE_REDIS_PASSWORD=
# 是否使用SSL连接Redis
CACHE_REDIS_SSL=false

# 缓存设置
# 是否启用缓存功能
CACHE_ENABLE_CACHE=true
# 是否启用缓存调试模式
CACHE_CACHE_DEBUG=false
# 默认缓存时间（秒）
CACHE_DEFAULT_TTL=3600
# 最大缓存时间（秒）
CACHE_MAX_TTL=86400
# 缓存键前缀
CACHE_CACHE_PREFIX=blogn2

# 应用配置
APP_NAME=BlogN2
APP_VERSION=1.0.0
DEBUG=true

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 安全配置
SECRET_KEY=your-secret-key-here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080 